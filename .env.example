# MedXplain-Simple — Environment Variables
# ==========================================

# Demo mode: uses mock pipeline (no GPU required)
MEDXPLAIN_DEMO_MODE=true

# Device: auto, cpu, or cuda
MEDXPLAIN_DEVICE=auto

# Enable Medra-4B clinical reasoning
MEDXPLAIN_ENABLE_MEDRA=true

# Enable Grad-CAM heatmap generation
MEDXPLAIN_ENABLE_GRADCAM=true

# Model checkpoint paths (optional)
BLIP2_CHECKPOINT=
MEDRA_CHECKPOINT=

# Google Gemini API key (optional, for query reformulation)
GEMINI_API_KEY=
